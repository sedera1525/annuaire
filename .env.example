# ─── OPENAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-nano

# ─── SERVEUR ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8090

# ─── LOGIN ────────────────────────────────────────────────
APP_USERNAME=admin
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(16))"
APP_PASSWORD=

# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-before-deploy

# ─── SÉCURITÉ ─────────────────────────────────────────────
# Domaines autorisés à appeler l'API (séparés par virgule)
ALLOWED_ORIGINS=https://topsocietes.com,https://www.topsocietes.com,https://entreprises-france.topsocietes.com

# Timeout OpenAI en secondes (défaut 30)
OPENAI_TIMEOUT=30

# ─── CACHE ────────────────────────────────────────────────
# Redis optionnel — si vide, fallback vers cache dict+TTL en mémoire
REDIS_URL=

# ─── SÉCURITÉ AVANCÉE ─────────────────────────────────────
# CSRF : désactiver uniquement pour le développement local (défaut : true)
CSRF_ENABLED=true

# ─── MONITORING ───────────────────────────────────────────
# Sentry DSN (optionnel — laisser vide pour désactiver)
SENTRY_DSN=
